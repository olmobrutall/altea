{
  // TEST layer — DB-FREE. The parse → `renderTemplate` round trip over a DOCUMENT, which the token
  // migration's document pass rests on: it rewrites the stored .docx bytes, so a `renderTemplate` that is
  // not faithful corrupts a template rather than failing.
  "extends": "../altea/presets/server.json",
  "compilerOptions": {
    // Cleared: the shipping layers block each other's subpaths behind the altea-client /
    // altea-server export conditions, but a test host deliberately spans both tiers.
    "customConditions": [],
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo.test",
    "types": ["node"]
  },
  "include": ["${configDir}/test/**/*"],
  "exclude": [],
  "references": [
    { "path": "./tsconfig.server.json" },
    { "path": "../altea/tsconfig.data.json" },
    { "path": "../altea/tsconfig.server.json" },
    { "path": "../altea-templating/tsconfig.server.json" }
  ]
}
