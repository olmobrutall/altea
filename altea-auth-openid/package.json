{
  "name": "@altea/altea-auth-openid",
  "version": "0.0.1",
  "description": "OpenID Connect login (ported from Signum.Authorization.OpenID)",
  "type": "module",
  "exports": {
    "./client/*": {
      "altea-server": null,
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./server/*": {
      "altea-client": null,
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tspc -b"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-auth": "workspace:*",
    "jose": "^6.1.0",
    "quote-transformer": "workspace:*"
  }
}
