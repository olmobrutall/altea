{
  "name": "@altea/altea-monaco",
  "version": "0.0.1",
  "description": "Monaco-based code editors",
  "type": "module",
  "exports": {
    "./client/*": {
      "altea-server": null,
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tspc -b"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "monaco-editor": "^0.54.0",
    "quote-transformer": "workspace:*"
  }
}
