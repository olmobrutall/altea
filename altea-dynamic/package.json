{
  "name": "@altea/altea-dynamic",
  "version": "0.0.1",
  "description": "Views defined in the database and rendered by an interpreter, plus CSS overrides and SQL migrations from the admin UI (ported from Signum.Dynamic)",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tspc -b"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-auth": "workspace:*",
    "@altea/altea-codemirror": "workspace:*",
    "@altea/altea-migrations": "workspace:*",
    "quote-transformer": "workspace:*",
    "@altea/altea-files": "workspace:*"
  }
}
