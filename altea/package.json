{
  "name": "@altea/altea",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "exports": {
    "./data/globals": {
      "types": "./dist/data/globals/index.d.ts",
      "default": "./dist/data/globals/index.js"
    },
    "./data/serializer": {
      "types": "./dist/data/serializer/index.d.ts",
      "default": "./dist/data/serializer/index.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "default": "./dist/data/*.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./server/*": {
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js"
    },
    "./client/*": {
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./loader.mjs": "./loader.mjs",
    "./register.mjs": "./register.mjs",
    "./vitest.shared.mjs": {
      "types": "./vitest.shared.d.mts",
      "default": "./vitest.shared.mjs"
    }
  },
  "scripts": {
    "build": "tspc -b",
    "test": "tspc -b && vitest run",
    "gen:postgres": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.postgres dist/test/server/generateEnvironment.js",
    "gen:sqlserver": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.sqlserver dist/test/server/generateEnvironment.js",
    "test:postgres": "tspc -b && vitest run --mode postgres",
    "test:sqlserver": "tspc -b && vitest run --mode sqlserver"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "bootstrap": "^5.3.8",
    "chalk": "^5.6.0",
    "decimal.js": "^10.6.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.10.1",
    "mssql": "^12.6.0",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "quote-transformer": "workspace:*",
    "react": "^19.0.0",
    "react-bootstrap": "^2.10.10",
    "react-router": "^8.3.0",
    "react-widgets-up": "^6.0.14",
    "temporal-polyfill": "^0.3.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mssql": "^12.3.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "vitest": "^5.0.0"
  }
}
