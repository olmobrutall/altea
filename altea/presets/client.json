{
  // Shared CLIENT-layer preset. `${configDir}` (TS 5.5+) expands to the consuming module's directory, so
  // a module's own tsconfig.client.json carries only its `references` (+ rarely a `types` override, e.g.
  // eastwind adds react/react-dom). See presets/data.json for the full `${configDir}` rationale.
  //
  // CLIENT = React UI kit (Navigator, Finder, SearchControl, Lines, …). Both organisations accepted: a
  // client/ directory OR co-located *.client.ts suffix files, plus ANY *.tsx (a .tsx is always a client
  // component). References DATA only, never server.
  //
  // The include list opens with `./styles.d.ts` — a path relative to THIS file, so every client project in
  // the workspace shares the ONE ambient `declare module "*.css"` / `"*.xml?raw"` file (see presets/styles.d.ts;
  // there used to be 18 identical copies, one per package, because an ambient decl only reaches the program
  // that includes it). `${configDir}/*.d.ts` still picks up a module's OWN root-level ambient decls
  // (e.g. eastwind/env.d.ts) — a no-op in modules that have none.
  //
  // `customConditions` is what ENFORCES "never server". Project `references` do not: they only order the
  // build and redirect an import of a REFERENCED project's output back to its source. An import of an
  // UNREFERENCED project resolves through node_modules to a `dist/**/*.d.ts` that is already on disk, and
  // TypeScript reads it as an ordinary declaration file — no error. So every altea package blocks its own
  // server subpath behind this condition (`"./server/*": { "altea-client": null, … }`), and a client file
  // reaching for `@altea/<pkg>/server/X` now fails to resolve. Nothing else sets `altea-client`, so node
  // and Vite keep resolving those subpaths through `default` — this is a COMPILE-time guard only.
  // (Within a package the boundary was already enforced: `server/**` is excluded below, so a relative
  // import of a *.server.ts sibling fails with TS6307.)
  "extends": "./base.json",
  "compilerOptions": {
    "rootDir": "${configDir}",
    "outDir": "${configDir}/dist",
    "tsBuildInfoFile": "${configDir}/dist/.tsbuildinfo.client",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "customConditions": ["altea-client"]
  },
  "include": [
    "./styles.d.ts",
    "${configDir}/client/**/*",
    "${configDir}/**/*.client.ts",
    "${configDir}/**/*.tsx",
    "${configDir}/*.d.ts"
  ],
  "exclude": ["${configDir}/data/**", "${configDir}/server/**", "${configDir}/terminal/**", "${configDir}/test/**"]
}
