{
  "name": "@altea/altea-email",
  "version": "0.0.1",
  "description": "Email messages, templates and the async sender (ported from Signum.Mailing)",
  "type": "module",
  "exports": {
    "./client/*": {
      "altea-server": null,
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./server/*": {
      "altea-client": null,
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tspc -b"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-auth": "workspace:*",
    "@altea/altea-codemirror": "workspace:*",
    "@altea/altea-files": "workspace:*",
    "@altea/altea-html-editor": "workspace:*",
    "@altea/altea-scheduler": "workspace:*",
    "@altea/altea-templating": "workspace:*",
    "@altea/altea-eval": "workspace:*",
    "@altea/altea-user-assets": "workspace:*",
    "@altea/altea-user-queries": "workspace:*",
    "nodemailer": "^7.0.0",
    "quote-transformer": "workspace:*",
    "@altea/altea-processes": "workspace:*"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.0"
  }
}
