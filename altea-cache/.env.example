# Copy to .env.postgres (or .env.sqlserver) and point it at a database this suite may DROP AND RECREATE.
# A value starting with "postgres" selects PostgreSQL; anything else is treated as a SQL Server
# connection string. Without it the DB-backed cases are SKIPPED (the files still compile and the
# no-database LiteColumnsFinder suite still runs).
#
# Seed it once with:  pnpm --filter @altea/altea-cache gen:postgres
ALTEA_CACHE_TEST_DB=postgresql://USER:PASSWORD@localhost:5432/altea_cache_test
