{
  "name": "@altea/altea-test",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:types": "tspc -b",
    "gen:postgres": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.postgres dist/server/generateEnvironment.js",
    "gen:sqlserver": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.sqlserver dist/server/generateEnvironment.js",
    "test:postgres": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.postgres --test --test-isolation=none \"dist/**/*.test.js\"",
    "test:sqlserver": "tspc -b && node --enable-source-maps --import ./register.mjs --env-file=.env.sqlserver --test --test-isolation=none \"dist/**/*.test.js\""
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "mssql": "^12.6.0",
    "pg": "^8.22.0",
    "quote-transformer": "workspace:*"
  }
}