{
  "name": "@altea/altea-isolation",
  "version": "0.0.1",
  "description": "Multi-tenancy by row: an isolation per tenant, an ambient current isolation, and a query filter per isolated table (ported from Signum.Isolation)",
  "type": "module",
  "exports": {
    "./client/*": {
      "altea-server": null,
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./server/*": {
      "altea-client": null,
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tspc -b",
    "test": "tspc -b && vitest run",
    "gen:postgres": "tspc -b && node --enable-source-maps --import @altea/altea/register.mjs --env-file=.env.postgres dist/test/server/generateEnvironment.js",
    "gen:sqlserver": "tspc -b && node --enable-source-maps --import @altea/altea/register.mjs --env-file=.env.sqlserver dist/test/server/generateEnvironment.js",
    "test:postgres": "tspc -b && vitest run --mode postgres",
    "test:sqlserver": "tspc -b && vitest run --mode sqlserver"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-auth": "workspace:*",
    "@altea/altea-files": "workspace:*",
    "@altea/altea-map": "workspace:*",
    "quote-transformer": "workspace:*"
  }
}
