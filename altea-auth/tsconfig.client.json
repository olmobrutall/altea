{
  // CLIENT layer — *.client.ts (client-side TS logic) plus ANY *.tsx (React components: in a framework
  // module a .tsx is always client). References DATA only — never server — so a client file cannot pull
  // server code into the bundle.
  "extends": "../altea/tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo.client",
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  // Both forms accepted: a client/ directory OR co-located *.client.ts suffix files, plus any *.tsx.
  "include": ["client/**/*", "**/*.client.ts", "**/*.tsx"],
  "exclude": ["data/**", "server/**"],
  "references": [
    { "path": "./tsconfig.data.json" },
    { "path": "../altea/tsconfig.client.json" }
  ]
}
