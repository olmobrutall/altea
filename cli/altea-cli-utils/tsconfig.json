{
    // STANDALONE on purpose: it does NOT extend altea's base preset, because that configures the
    // quote-transformer ts-patch plugin — a dependency these tools must not have. Plain `tsc`, node
    // builtins only, so a tool keeps working when the framework it edits does not compile.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "declaration": true,
        "sourceMap": true,
        "rootDir": ".",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/.tsbuildinfo"
    },
    "include": ["**/*.ts"],
    "exclude": ["dist/**", "node_modules/**"]
}
