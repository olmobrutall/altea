{
    // STANDALONE on purpose: it does NOT extend altea's base preset, because that configures the
    // quote-transformer ts-patch plugin — a dependency this tool must not have. Plain `tsc`, node
    // builtins only, so it runs from a bare checkout before any `pnpm install`.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "sourceMap": true,
        // rootDir is the cli/ FOLDER, not this package: altea-clone and altea-simplify compile
        // altea-upgrade's shared sources alongside their own, so the output mirrors the source layout
        // and a relative import ("../altea-upgrade/Git.js") resolves the same before and after emit.
        "rootDir": "..",
        "outDir": "./dist"
    },
    "include": ["./**/*.ts"],
    "exclude": ["dist/**", "node_modules/**"]
}
