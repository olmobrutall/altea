{
    // See altea-cli-utils' tsconfig for why these are standalone rather than extending the base preset.
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": ["node"],
        "strict": true,
        "verbatimModuleSyntax": true,
        "forceConsistentCasingInFileNames": true,
        "composite": true,
        "declaration": true,
        "sourceMap": true,
        "rootDir": ".",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/.tsbuildinfo"
    },
    "include": ["**/*.ts"],
    "exclude": ["dist/**", "node_modules/**"],
    "references": [
        { "path": "../altea-cli-utils/tsconfig.json" }
    ]
}
