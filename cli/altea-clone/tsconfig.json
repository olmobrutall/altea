{
    // See altea-upgrade's tsconfig for why this extends the base preset directly.
    "extends": "../../altea/presets/base.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "./dist",
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
        "types": ["node"]
    },
    "include": ["**/*.ts"],
    "exclude": ["dist/**", "node_modules/**"],
    "references": [
        { "path": "../../altea/tsconfig.server.json" },
        { "path": "../altea-upgrade/tsconfig.json" }
    ]
}
