{
  "name": "@altea/altea-sms",
  "version": "0.0.1",
  "description": "SMS templates, messages and the send / update-status process algorithms (ported from Signum.SMS)",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tspc -b",
    "test": "tspc -b && node --enable-source-maps --import @altea/altea/register.mjs --test \"dist/test/**/*.test.js\""
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-processes": "workspace:*",
    "@altea/altea-scheduler": "workspace:*",
    "@altea/altea-templating": "workspace:*",
    "@altea/altea-user-assets": "workspace:*",
    "quote-transformer": "workspace:*"
  }
}
