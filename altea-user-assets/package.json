{
  "name": "@altea/altea-user-assets",
  "version": "0.0.1",
  "description": "Shared user-asset infrastructure: embedded query model (tokens/filters), filter converter, XML import/export (ported from Signum.UserAssets)",
  "type": "module",
  "exports": {
    "./client/*": {
      "altea-server": null,
      "types": "./dist/client/*.d.ts",
      "default": "./dist/client/*.js"
    },
    "./server/*": {
      "altea-client": null,
      "types": "./dist/server/*.d.ts",
      "default": "./dist/server/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tspc -b",
    "test": "tspc -b && vitest run"
  },
  "keywords": [],
  "author": "Olmo del Corral",
  "license": "MIT",
  "dependencies": {
    "@altea/altea": "workspace:*",
    "@altea/altea-auth": "workspace:*",
    "quote-transformer": "workspace:*"
  }
}
